library(kohonen)
library(MASS)
library(cluster) # For creating synthetic data
# 1. GENERATE BIGGER DATASET (Synthetic)
# We create 5000 points in 5 dimensions centered around 4 distinct clusters
set.seed(123)
n_points <- 5000
n_dim <- 5
n_clusters <- 4
# Create random data concentrated around 4 centers
data_raw <- matrix(0, nrow = n_points, ncol = n_dim)
centers <- matrix(rnorm(n_clusters * n_dim, sd = 3), n_clusters, n_dim)
for(i in 1:n_points) {
# Assign each point to a random cluster center + noise
clust <- sample(1:n_clusters, 1)
data_raw[i, ] <- centers[clust, ] + rnorm(n_dim, sd = 0.8)
}
# Scale the data
data.sc <- scale(data_raw)
# 2. TRAIN SOM (LARGE GRID)
# A 20x20 grid = 400 nodes
som.grid <- somgrid(xdim = 20, ydim = 20, topo = "hexagonal")
som.model <- som(data.sc, grid = som.grid, rlen = 200, alpha = c(0.05, 0.01))
# 3. DEFINE COLORS (CLUSTERING THE CODEBOOKS)
# We cluster the 400 codebook vectors to see how the SOM organized the 4 data groups
codes <- som.model$codes[[1]]
dist.matrix <- dist(codes)
hc <- hclust(dist.matrix)
# Cut tree into 4 groups (matching our original data structure)
k <- 4
som_clusters <- cutree(hc, k = k)
# Create a vibrant color palette
# Using transparency (alpha) helps when points overlap in the projection
colors_def <- c("#E41A1C", "#377EB8", "#4DAF4A", "#984EA3") # Red, Blue, Green, Purple
node.colors <- colors_def[som_clusters]
# 4. COMPUTE SAMMON PROJECTION
# This projects the 400 codebook vectors from 5D -> 2D
# Note: Sammon can be slow; for 400 points it is fast (seconds)
sammon.proj <- sammon(dist.matrix, k = 2, trace = FALSE)
par(mfrow = c(1, 2), mar = c(2, 2, 3, 1))
# PLOT A: SOM Grid
plot(som.model,
type = "mapping",
bgcol = node.colors,
main = "SOM Grid (20x20)\nHexagonal Topology",
pchs = "",
shape = "straight",
border = "gray50")
# Add boundaries to emphasize the regions
add.cluster.boundaries(som.model, som_clusters, lwd = 2)
# PLOT B: Sammon Projection
plot(sammon.proj$points,
type = "n",
main = "Sammon Projection\n(Topological Unfolding)",
xlab = "", ylab = "", axes = FALSE)
box()
# 1. Draw Mesh (Connecting Neighbors)
grid.dists <- unit.distances(som.grid)
proj.coords <- sammon.proj$points
# Draw lines for immediate neighbors (distance <= 1.1 covers hex neighbors)
for (i in 1:(nrow(grid.dists) - 1)) {
# Optimization: Only check neighbors within reasonable index range to speed up loop
# But for 400 nodes, full loop is fine
for (j in (i + 1):nrow(grid.dists)) {
if (grid.dists[i, j] <= 1.1) {
segments(x0 = proj.coords[i, 1], y0 = proj.coords[i, 2],
x1 = proj.coords[j, 1], y1 = proj.coords[j, 2],
col = "gray80", lwd = 0.5)
}
}
}
# 2. Draw Nodes
points(sammon.proj$points,
pch = 21,
bg = node.colors,
col = "gray30",
cex = 1.0)
# Reset layout
par(mfrow = c(1, 1))
source("~/.active-rstudio-document")
