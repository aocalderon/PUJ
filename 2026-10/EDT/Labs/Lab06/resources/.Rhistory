source("~/MEGA/Work/PUJ/2026-10/EDT/Labs/Lab05/resources/play_tennis_dataset.R")
source("~/MEGA/Work/PUJ/2026-10/EDT/Labs/Lab05/resources/Advertisement.R")
# Loading the Advertisement dataset
dataset <- read.csv("Advertisement.csv")
head(dataset, 10)
# Convert target variable to factor
dataset$Purchased <- factor(dataset$Purchased, levels = c(0, 1))
# Splitting dataset
set.seed(42)
split <- sample.split(dataset$Purchased, SplitRatio = 0.75)
training_set <- subset(dataset, split == TRUE)
test_set <- subset(dataset, split == FALSE)
head(training_set, 5)
# Normalize numerical features
training_set[c("Age", "EstimatedSalary")] <- scale(training_set[c("Age", "EstimatedSalary")])
test_set[c("Age", "EstimatedSalary")] <- scale(test_set[c("Age", "EstimatedSalary")])
head(training_set, 5)
head(test_set, 5)
# Fitting Decision Tree to the Training set
classifier <- rpart(formula = Purchased ~ Age + EstimatedSalary,
data = training_set,
method = "class")
rpart.plot(classifier,
type = 2,
extra = 101,
under = TRUE,
box.palette = "GnYlRd",
main = "Play Tennis Decision Logic")
rpart.plot(classifier,
type = 2,
extra = 101,
under = TRUE,
box.palette = "BlYlRd",
main = "Ad Decision Logic")
rpart.plot(classifier,
type = 2,
extra = 101,
under = TRUE,
box.palette = "BlGnYl",
main = "Ad Decision Logic")
# Decision tree
rpart.plot(classifier,
type = 2,
extra = 101,
under = TRUE,
box.palette = "BlGnYl",
main = "Ad Decision Logic")
